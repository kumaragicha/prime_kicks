generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  APPROVED_PAYMENT_RECEIVED
  APPROVED_PAYMENT_PENDING
  REJECTED
}

enum PaymentStatus {
  PENDING
  RECEIVED
}

/// How an admin-created order is classified: a single item (retail-style) or a bulk reseller order.
/// Lifecycle of an order's shipment with the Shipmozo courier aggregator.
enum ShipmentStatus {
  NOT_SHIPPED // no attempt yet
  PUSHED // order created in the Shipmozo panel
  ASSIGNED // a courier partner has been assigned (tracking id available)
  FAILED // last push/assign attempt errored
  CANCELLED // order was cancelled in the Shipmozo panel (kept in sync on our cancel/delete)
}

enum OrderType {
  BULK
  SINGLE
}

// How a web customer order is paid. Null on reseller / credit / admin orders.
enum PaymentMethod {
  ONLINE // full amount paid online (Razorpay)
  COD // advance paid online, balance collected in cash on delivery
}

enum CouponType {
  PERCENT // discountValue is a percentage (1–100)
  FLAT // discountValue is a whole-rupee amount
}

enum UserRole {
  CUSTOMER
  RESELLER
  ADMIN
}

/// Which part of the system an audit-log entry belongs to.
enum AuditModule {
  PRODUCTS
  ORDERS
  USERS
  CART
  SIZE_TYPES
  SIZES
  BRANDS
  CATEGORIES
  PRODUCT_TYPES
  TAGS
  DIMENSIONS
  SHIPMENTS
  AUTH
  CREDIT_CUSTOMERS
}

/// The kind of change an audit-log entry records.
enum AuditEvent {
  CREATION
  UPDATION
  DELETION
  READ
}

/// Append-only trail of every create/update/delete performed through the API.
/// Written non-blocking (a failed audit insert never fails the real operation),
/// so it's a debugging/history aid, not a transactional guarantee.
model AuditLog {
  id              String      @id @default(cuid())
  referenceNumber String? // human-facing ref for the affected row (e.g. order number, SKU)
  module          AuditModule
  moduleId        String? // id of the affected row (cuid); null for bulk/none
  subModule       String?
  event           AuditEvent
  action          String // short human description ("Product created")
  formData        Json? // snapshot of the payload/entity at the time of the change
  auditedBy       String // email of the acting user (or "system")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([module, moduleId])
  @@index([event])
  @@index([auditedBy])
  @@index([referenceNumber])
  @@index([createdAt])
}

/// Storefront accounts are created from a name and a mobile number alone,
/// verified by a WhatsApp OTP — mobileNo is the identity, not email.
///
/// email / passwordHash / city / state are nullable because OTP accounts never
/// supply them. They remain populated for ADMIN accounts (which still sign in
/// with a password) and for accounts created before the OTP flow.
model User {
  id        String   @id @default(cuid())
  firstName String
  lastName  String?  // optional — signup collects one "name" field and splits it
  name      String // full display name as entered
  email     String?  @unique // null for OTP-only accounts
  mobileNo  String   @unique // the login identity
  city      String?
  state     String?
  role      UserRole @default(CUSTOMER)
  isActive  Boolean  @default(true) // false = disabled (cannot log in)

  // Auth
  passwordHash     String?   // null for OTP-only accounts (no password login)
  isEmailVerified  Boolean   @default(false)
  lastLoginAt      DateTime?

  orders        Order[]
  razorpayCheckoutSessions RazorpayCheckoutSession[]
  cart          Cart?
  passwordReset PasswordResetToken?
  refreshTokens RefreshToken[] // one row per active login session (multi-device)
  savedAddresses SavedAddress[] // checkout addresses the customer chose to save

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete

  @@index([role])
  // Backs the admin user list: `where deletedAt IS NULL order by createdAt desc`.
  @@index([deletedAt, createdAt])
}

/// One row per active login session. Holds the bcrypt hash of that session's
/// refresh token (rotated on every use) plus its own expiry, so a user can be
/// signed in on multiple devices/tabs at once without sessions invalidating one
/// another. The row id is embedded as the refresh JWT's `jti`, so refresh can
/// look up exactly which session to verify and rotate.
model RefreshToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String // bcrypt hash of sha256(refresh token) for this session
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

/// A non-login account for admin-created bulk orders taken on credit (e.g. a
/// customer who orders in bulk over the phone). Unlike User there is no password
/// or auth — it exists purely so bulk orders and their outstanding payments can
/// be tracked against a named customer.
model CreditCustomer {
  id       String  @id @default(cuid())
  name     String
  mobileNo String
  email    String?
  city     String?
  state    String?
  notes    String? // free-form admin notes

  orders Order[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete

  // Backs the admin credit-customer list: active rows, newest first.
  @@index([deletedAt, createdAt])
}

/// A pending password-reset request. Holds only the sha256 hash of the emailed
/// token (never the token itself). One active row per user — a new request
/// overwrites the previous one (upsert). Consumed (deleted) on a successful
/// reset or when it expires.
model PasswordResetToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
  tokenHash String   @unique // sha256 of the raw token from the emailed link
  expiresAt DateTime // link is invalid after this instant

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

/// A signup awaiting email-OTP confirmation. Holds the full (password-hashed)
/// registration payload until the emailed code is verified, at which point the
/// real `User` row is created and this record is deleted. One pending row per
/// email — a repeat "start" overwrites the previous one (upsert).
/// A pending WhatsApp OTP for a mobile number, used for BOTH sign-up and login
/// (they are the same flow: verify the number, then either create the account
/// or sign in to the existing one).
///
/// One row per mobile number — requesting a new code replaces the old one, so a
/// number can never have two live codes. Only the sha256 of the code is stored.
model MobileOtp {
  id       String @id @default(cuid())
  mobileNo String @unique

  codeHash   String // sha256 of the 6-digit OTP (never stored in the clear)
  expiresAt  DateTime // code is invalid after this instant
  attempts   Int      @default(0) // wrong-code submissions, capped to throttle guessing
  lastSentAt DateTime @default(now()) // gates how often a new code can be requested

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

/// A size system (e.g. "Nike", "Adidas", "Crocs"). Groups the valid sizes.
model SizeType {
  id       String @id @default(cuid())
  name     String @unique
  isActive Boolean @default(true)

  sizes    Size[]
  products Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
}

/// An individual size within a size type. `label` is the primary value ("36",
/// "M3"); `conversion` is an optional secondary label ("UK 3").
model Size {
  id         String   @id @default(cuid())
  sizeType   SizeType @relation(fields: [sizeTypeId], references: [id], onDelete: Cascade)
  sizeTypeId String
  label      String
  conversion String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)

  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sizeTypeId, label])
  @@index([sizeTypeId])
}

model Product {
  id          String @id @default(cuid())
  sku         String @unique
  name        String
  brand       String
  brandRef    Brand? @relation(fields: [brandId], references: [id])
  brandId     String?
  // Style/model name shared across colorways, e.g. "Samba" for both
  // "Adidas Samba Green" and "Adidas Samba Black". Free text; grouping in the
  // catalog is by (brand + lower(model)) so a model's colorways list together.
  model       String?
  // Denormalised sort key = the group's newest createdAt (maintained on write).
  // Colorways of a model share one value so the catalog lists them adjacently
  // with a plain indexed ORDER BY — no per-request grouping. Defaults to the
  // row's own createdAt for solo (no-model) products.
  groupSortAt DateTime @default(now())
  description String @default("")

  // Media
  photoUrls String[]
  videoUrl  String?

  // Pricing in whole Indian rupees.
  inhouseCost   Int // what the product costs us
  resellerPrice Int // selling price offered to resellers
  customerPrice Int // selling price offered to customers
  currency      String @default("INR")

  releaseYear Int?

  // When false the product is hidden from the storefront (all non-admin reads
  // filter `isActive: true`) but stays visible and editable in the admin.
  isActive Boolean @default(true)

  // Sizing — one size type per product, with per-size stock in variants
  sizeType   SizeType         @relation(fields: [sizeTypeId], references: [id])
  sizeTypeId String
  variants   ProductVariant[]
  productTypes ProductType[]
  categories Category[]
  tags       Tag[]

  // Physical dimension — at most one per product, chosen at creation.
  dimension   Dimension? @relation(fields: [dimensionId], references: [id])
  dimensionId String?

  orderItems OrderItem[]
  cartItems  CartItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete

  @@index([brand])
  @@index([brandId])
  @@index([sizeTypeId])
  @@index([dimensionId])
  // Backs catalog grouping of a model's colorways (brand + model).
  @@index([brandId, model])
  // Backs the catalog listing order (groupSortAt desc, then group fields).
  @@index([groupSortAt])
  // Backs the storefront/admin catalog: `where deletedAt IS NULL order by createdAt desc`.
  @@index([deletedAt, createdAt])
}

/// Product brand master, e.g. Adidas or Puma.
model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  products  Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Product type master, e.g. Sneaker, Casual or Sport.
model ProductType {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  products  Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Customer category master, e.g. Men or Women.
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  products  Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Merchandising tag master, e.g. New Arrivals, Hot Selling or Most Demanded.
/// A product can carry any number of tags; used to group products for storefront
/// promotions and admin curation.
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  products  Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Physical box/product dimension master, e.g. "Standard Shoe Box".
/// Measurements are in centimetres. A product can be linked to at most one
/// dimension (chosen at creation time); the same dimension can back many products.
model Dimension {
  id        String    @id @default(cuid())
  name      String    @unique
  weight    Float     @default(0.5) // kg — used as the shipment weight when this dimension is mapped to a product
  length    Float // cm
  width     Float // cm
  height    Float // cm
  isActive  Boolean   @default(true)
  products  Product[]

  // Combination relations: a dimension can be the resulting "box" of some
  // combinations and/or appear as a recipe item in others.
  combinationBoxes DimensionCombination[]     @relation("CombinationBox")
  combinationItems DimensionCombinationItem[] @relation("CombinationItemDimension")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// A quantity-based shipment rule: when an order's basket of product dimensions
/// exactly matches this combination's recipe (see items), the shipment uses this
/// combination's `weight` and the `boxDimension`'s measurements instead of the
/// per-product dimension. Used for multi-unit orders (qty >= 2).
model DimensionCombination {
  id             String                     @id @default(cuid())
  name           String                     @unique
  weight         Float // kg — resulting shipment weight for this combination
  boxDimension   Dimension                  @relation("CombinationBox", fields: [boxDimensionId], references: [id])
  boxDimensionId String
  isActive       Boolean                    @default(true)
  items          DimensionCombinationItem[]
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([boxDimensionId])
}

/// One line of a combination's recipe: "this dimension × this quantity".
model DimensionCombinationItem {
  id            String               @id @default(cuid())
  combination   DimensionCombination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  combinationId String
  dimension     Dimension            @relation("CombinationItemDimension", fields: [dimensionId], references: [id])
  dimensionId   String
  quantity      Int

  @@unique([combinationId, dimensionId])
  @@index([combinationId])
  @@index([dimensionId])
}

/// Admin-editable Shipmozo integration settings. Single row (id = "singleton")
/// so the whole shipment flow can be controlled from the admin without env/code
/// changes.
model ShipmozoSetting {
  id                String   @id @default("singleton")
  enabled           Boolean  @default(true) // false → orders stay in our system only, no Shipmozo push
  autoAssignCourier Boolean  @default(false) // true → auto-run courier assignment after a successful push
  warehouseId       String   @default("") // overrides SHIPMOZO_WEARHOUSE_ID env when set
  skipStates        String[] @default([]) // orders shipping to these states are NOT pushed to Shipmozo
  autoAssignSkipUserIds String[] @default([]) // orders owned by these users push only — never auto-assign a courier
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Admin-editable global pricing knobs. Single row (id = "singleton").
/// `resellerShippingDeduction` is the per-unit amount stripped from the reseller
/// price when a reseller self-handles delivery (pickup / label) — shipping is
/// baked into resellerPrice, so it's removed when we don't ship for them.
model PricingSetting {
  id                        String   @id @default("singleton")
  resellerShippingDeduction Int      @default(0) // per-unit INR removed on reseller pickup/label orders
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

/// Courier configuration for different weight slabs. Maps weight ranges to
/// specific courier company and service type IDs from Shipmozo panel.
/// Multiple mappings are allowed within a slab and are evaluated by priority.
model CourierConfig {
  id                          String   @id @default(cuid())
  weightSlab                  String   // e.g. "1kg", "2kg", "5kg"
  courierCompanyId            String   // Shipmozo courier_company_id (e.g., "2" for Delhivery)
  courierCompanyServiceTypeId String   // Shipmozo courier_company_service_type_id for this weight
  label                       String?  // optional admin-friendly name, e.g. "Delhivery Surface"
  priority                    Int      @default(0) // lower values are tried first within the same slab
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weightSlab, priority])
}

/// Per-size stock for a product (product X, size UK 3, qty 5).
model ProductVariant {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  size      Size    @relation(fields: [sizeId], references: [id])
  sizeId    String
  sku       String? @unique
  stock     Int     @default(0)

  orderItems OrderItem[]
  cartItems  CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, sizeId])
  @@index([productId])
  @@index([sizeId])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  // Optional client-supplied idempotency key (from the `Idempotency-Key` header).
  // A retried checkout with the same key returns the original order instead of
  // creating a duplicate. Unique so a race resolves to a single order.
  idempotencyKey String?    @unique
  // An order is owned by EXACTLY ONE of: a login User (web / reseller) OR a
  // CreditCustomer (admin-created bulk order on credit). Enforced in the service.
  user          User?       @relation(fields: [userId], references: [id])
  userId        String?
  creditCustomer   CreditCustomer? @relation(fields: [creditCustomerId], references: [id])
  creditCustomerId String?
  status        OrderStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  orderType     OrderType   @default(SINGLE)
  shippingStatus PaymentStatus @default(PENDING)
  items         OrderItem[]

  // Pricing
  subtotal Int
  shipping Int    @default(0)
  // Coupon discount applied at checkout (whole rupees; 0 when none). total =
  // subtotal + shipping - discount. Web customer (prepaid) orders only.
  discount Int    @default(0)
  total    Int
  currency String @default("INR")

  // Web customer payment: ONLINE (paid in full) or COD (advancePaid now via
  // Razorpay, codAmount collected by the courier). Null for other order kinds.
  paymentMethod PaymentMethod?
  advancePaid   Int @default(0)
  codAmount     Int @default(0)

  // Coupon redeemed on this order, if any. `couponCode` is a snapshot so the
  // code still shows even if the coupon is later edited or deleted.
  coupon     Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponId   String?
  couponCode String?

  // Fulfilment method: false (default) = ship to the address, true = customer picks up in store.
  isPickup Boolean @default(false)

  // Shipping address
  addressName        String
  addressEmail       String?  // optional — not all customers provide an email
  addressMobileNo    String
  addressAltMobileNo String?  // optional alternative phone number
  addressLine1       String
  addressLine2       String  @default("")
  landmark           String  @default("")
  pincode            String
  city               String
  state              String

  // Razorpay payment (web storefront only — reseller/credit orders never set
  // these). Set when a checkout session is created, then confirmed by either
  // the client-side verify call or the payment.captured webhook, whichever
  // arrives first — both paths are idempotent against each other.
  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  // Reverse side of RazorpayCheckoutSession.order — set once the session that
  // paid for this order is confirmed. Most orders (reseller/credit/admin) have
  // none; Prisma needs this field purely to express the relation both ways.
  razorpayCheckoutSession RazorpayCheckoutSession?

  // Shipmozo shipment integration. An order is pushed to the Shipmozo panel
  // right after creation; the courier + tracking id arrive in a later step.
  shipmentStatus      ShipmentStatus @default(NOT_SHIPPED)
  shipmozoOrderId     String? // Shipmozo's internal order id (from push-order)
  shipmozoReferenceId String? // Shipmozo's reference_id (from push-order)
  courierPartner      String? // assigned courier name (once assigned)
  trackingId          String? // AWB / tracking number shown to the customer
  shipmentError       String? // last push/assign error, for admin diagnostics
  shipmentPushedAt    DateTime?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Backs "my orders" and the per-user receivables list (userId + createdAt sort).
  @@index([userId, createdAt])
  // Backs the per-credit-customer receivables list.
  @@index([creditCustomerId, createdAt])
  // Backs the admin order list filtered by status and sorted by date, plus the
  // APPROVED_PAYMENT_PENDING receivables rollup.
  @@index([status, createdAt])
  // Backs the admin order list's common case: no status filter, sorted by date
  // (a bare createdAt sort neither composite index above can serve).
  @@index([createdAt])
}

// A web customer's checkout "intent" — created when Razorpay checkout opens,
// BEFORE any Order exists. No Order is created until payment is confirmed: an
// abandoned/failed checkout leaves no order, no stock touched, cart untouched.
// Web storefront only — reseller/credit orders never create one of these.
/// A customer's saved checkout address ("Save this address for future orders").
/// A customer can keep several and pick one at checkout.
model SavedAddress {
  id          String  @id @default(cuid())
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  email       String?
  mobileNo    String
  altMobileNo String?
  line1       String
  line2       String  @default("")
  landmark    String  @default("")
  pincode     String
  city        String
  state       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Backs "my saved addresses" (most recently used first).
  @@index([userId, updatedAt])
}

model Coupon {
  id          String     @id @default(cuid())
  // Stored uppercased + trimmed; customers type it case-insensitively.
  code        String     @unique
  description String     @default("")
  type        CouponType @default(PERCENT)
  // For PERCENT: 1–100. For FLAT: whole rupees.
  value       Int
  // PERCENT only: cap the rupee discount (null = uncapped). Ignored for FLAT.
  maxDiscount Int?
  // Minimum order subtotal (whole rupees) required to use the coupon.
  minOrderValue Int @default(0)

  // Eligibility. Both default true to match the launch coupon: customer-only,
  // prepaid-only. Reseller/credit/admin orders never qualify while customerOnly.
  customerOnly Boolean @default(true)
  prepaidOnly  Boolean @default(true)

  // Usage caps. `usageLimit` is the total redemptions across everyone (null =
  // unlimited); `usedCount` is incremented as orders redeem it. `perUserLimit`
  // caps redemptions per customer (null = unlimited), counted from Orders.
  usageLimit   Int?
  usedCount    Int  @default(0)
  perUserLimit Int?

  // Validity window (null = open-ended on that side).
  validFrom  DateTime?
  validUntil DateTime?

  isActive Boolean @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model RazorpayCheckoutSession {
  id              String @id @default(cuid())
  user            User   @relation(fields: [userId], references: [id])
  userId          String
  razorpayOrderId String @unique
  // Optional client-supplied idempotency key (from the `Idempotency-Key`
  // header) — a retried "Place order" click with the same key reuses this
  // session's Razorpay order instead of opening a duplicate.
  idempotencyKey  String? @unique

  // Snapshot of what the customer intended to buy — re-validated (stock +
  // price) again at payment-confirmation time, since time has passed and
  // either can have moved; this snapshot is just the original intent.
  itemsJson   Json
  addressJson Json?
  isPickup    Boolean @default(false)
  // ONLINE = `amount` is the full total; COD = `amount` is the advance only.
  paymentMethod PaymentMethod @default(ONLINE)
  // Coupon code the customer applied, re-validated at confirmation time before
  // the order is created (price/eligibility can move between start and pay).
  couponCode  String?

  amount   Int // paise Razorpay was told to collect
  currency String @default("INR")

  // PENDING: checkout opened, not yet confirmed.
  // CONSUMING: payment signature verified, Order creation in progress — an
  //   atomic claim held by exactly one of (verify / redirect callback /
  //   webhook), however many of them fire for the same payment. Transient;
  //   should never be visible for more than the duration of one DB
  //   transaction. Stuck here means the order-creation attempt crashed
  //   mid-flight and needs a human (payment captured, no order, no refund).
  // CONSUMED: payment verified, Order created (see orderId).
  // REFUNDED: payment captured but the order couldn't be fulfilled (e.g. the
  //   item sold out in the meantime) — auto-refunded, no Order created.
  // FAILED: payment never completed (informational only; nothing to clean up
  //   since no stock/order was ever touched).
  status            String  @default("PENDING")
  order             Order?  @relation(fields: [orderId], references: [id])
  orderId           String? @unique
  razorpayPaymentId String? // set once captured, kept even if later refunded
  refundId          String? // Razorpay refund id, set only if status = REFUNDED
  refundedAt        DateTime?
  /// Why the order couldn't be fulfilled (e.g. which item sold out) — shown to admins.
  refundReason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Backs the admin-visible list and periodic cleanup of old PENDING sessions.
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Cart {
  id        String     @id @default(cuid())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String     @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  variantId String
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([productId])
}

model OrderItem {
  id             String          @id @default(cuid())
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  product        Product         @relation(fields: [productId], references: [id])
  productId      String
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantId      String?
  title          String
  sku            String
  sizeLabel      String? // snapshot of the size sold (e.g. "UK 3")
  quantity       Int
  unitPrice Int

  @@index([orderId])
  @@index([productId])
}

/// A slide in the storefront homepage hero carousel. Managed from the admin
/// "Hero Banner" module; the web home renders active slides ordered by sortOrder.
model HeroSlide {
  id        String  @id @default(cuid())
  imageUrl  String
  /// Optional portrait/mobile crop. Empty means fall back to imageUrl.
  mobileImageUrl String @default("")
  title     String  @default("")
  subtitle  String  @default("")
  ctaLabel  String  @default("")
  ctaHref   String  @default("")
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}
