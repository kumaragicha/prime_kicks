# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prime_kicks?schema=public"

# HTTP port the API listens on
PORT=4000

# Comma-separated list of allowed CORS origins (web + admin)
# Shared secret the reseller storefront sends as the `x-storefront` header to
# receive wholesale pricing. Must match RESELLER_STOREFRONT_KEY in
# apps/reseller/.env, where the server-side proxy injects it. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Unset in production = reseller pricing disabled (fails closed to retail).
RESELLER_STOREFRONT_KEY=""

# 3000 web · 3001 admin · 3002 reseller
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# Public base URL of the storefront web app, used to build links in emails
# (e.g. the password-reset link). MUST be set to the real domain in production
# — no trailing slash, e.g. https://primekicks.com. Otherwise reset emails
# point at http://localhost:3000.
WEB_APP_URL="http://localhost:3000"

# Access-token secret + lifetime (zeit/ms format, e.g. 15m, 1h, 7d)
JWT_SECRET="change-me-to-a-long-random-access-secret"
JWT_EXPIRES_IN="15m"

# Refresh-token secret + lifetime (must differ from the access secret)
JWT_REFRESH_SECRET="change-me-to-a-long-random-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# ── WhatsApp Cloud API (registration OTP) ───────────────────────────────
# Meta for Developers → your app → WhatsApp → API Setup.
# If PHONE_NUMBER_ID/ACCESS_TOKEN are left blank, OTP codes are LOGGED to the
# API console instead of sent — handy for local dev with zero setup. That
# fallback is REFUSED when NODE_ENV=production.
#
# "From" dropdown on API Setup → the numeric id beneath the phone number
WHATSAPP_PHONE_NUMBER_ID=""
# A System User token (permanent). The temporary token on API Setup expires in
# 24h and must never be used in a deployed environment.
WHATSAPP_ACCESS_TOKEN=""
# Graph API version. Pinned deliberately — bump only after testing.
WHATSAPP_API_VERSION="v22.0"
# ── WhatsApp webhook (delivery receipts / review alerts) ────────────────
# Callback URL to enter in Meta → App → WhatsApp → Configuration:
#   https://<public-api-domain>/api/webhook/whatsapp
# Verify token: any long random string YOU choose; paste the same value in Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# App Secret: Meta app → Settings → Basic → App secret. Signs every POST.
# Unset = webhook POSTs are rejected (fails closed).
WHATSAPP_APP_SECRET=""
# Name of the APPROVED Authentication-category template on the WABA
WHATSAPP_OTP_TEMPLATE="prime_kicks_otp"
# Language code of that template — must match exactly ("en" vs "en_US" differ)
WHATSAPP_OTP_TEMPLATE_LANG="en"
# Country code prepended to bare 10-digit numbers (91 = India)
WHATSAPP_DEFAULT_COUNTRY_CODE="91"
# Hard timeout per Cloud API request, in ms
WHATSAPP_TIMEOUT_MS="10000"

# ── Email / SMTP (password reset) ───────────────────────────────────────
# Recommended: Brevo (free 300 emails/day). Dashboard → "SMTP & API" → "SMTP".
# Any SMTP provider works though (Zoho, Mailgun, Amazon SES, Gmail app pw…).
# If SMTP_HOST/USER/PASS are left blank, emails are LOGGED to the API
# console instead of sent — handy for local dev with zero setup.
# Registration OTP is sent over WhatsApp (above); SMTP now only carries
# password-reset links.
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
# true only for implicit-TLS ports (465); 587/25 use STARTTLS automatically
SMTP_SECURE="false"
# Brevo SMTP login (e.g. 8xxxxx001@smtp-brevo.com) — NOT your account email
SMTP_USER=""
# Brevo "SMTP key" — NOT your Brevo account password
SMTP_PASS=""
# From address shown on outgoing email — must be a VERIFIED sender in Brevo
MAIL_FROM="Prime Kicks <no-reply@primekicks.com>"
# Optional address recipients can reply to (improves deliverability)
MAIL_REPLY_TO=""
# How long a verification code stays valid, in minutes
OTP_EXP_MINUTES="10"

# Print each OTP to the API console. A logged code IS a working login for that
# account, so this is debugging-only and is REFUSED when NODE_ENV=production.
# Needed today because the Meta test WABA cannot send an authentication template
# (docs/whatsapp-otp.md), so codes cannot arrive on a phone yet.
OTP_LOG_CODES="false"

# ── Cloudflare R2 (product media storage) ───────────────────────────────
# Account ID → endpoint https://<id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public custom CDN domain bound to the bucket, no trailing slash
# e.g. https://cdn.primekicks.com
R2_PUBLIC_URL=""
# Upload size caps (megabytes)
MAX_IMAGE_MB=15
MAX_VIDEO_MB=100
# WebP re-encode quality (1–100). 80 = visually lossless but well optimized.
WEBP_QUALITY=80

# Shipmozo courier-aggregator integration.
SHIPMOZO_PRIVATE_KEY=
SHIPMOZO_PUBLIC_KEY=
# Warehouse id from the Shipmozo panel (Get-Warehouses API). Note the key spelling.
SHIPMOZO_WEARHOUSE_ID=
# Pickup pincode of the warehouse — used for the pincode-serviceability check.
SHIPMOZO_PICKUP_PINCODE=
# "false" = log a not-serviceable result but still push; "true" = block the push.
SHIPMOZO_ENFORCE_SERVICEABILITY=true
SHIPMOZO_BASE_URL="https://shipping-api.com/app/api/v1"
# Fallback box dimensions (cm) when a product has no linked Dimension.
SHIPMOZO_DEFAULT_LENGTH_CM=30
SHIPMOZO_DEFAULT_WIDTH_CM=20
SHIPMOZO_DEFAULT_HEIGHT_CM=12

# Shared secret for the internal auto-cancel cron endpoint (POST /api/orders/internal/auto-cancel).
# Set the same value in your server crontab curl call. Leave unset to disable the endpoint.
INTERNAL_CRON_SECRET=
