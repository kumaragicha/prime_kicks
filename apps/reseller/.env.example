# The browser calls this app's own origin; app/api/[...path]/route.ts proxies to
# the real API server-side. Keep it relative so the secret below never has to
# leave the server.
NEXT_PUBLIC_API_URL="/api"

# Origin of the NestJS API, used by the proxy only (server-side).
API_URL="http://localhost:4000/api"

# Shared secret the proxy injects as the `x-storefront` header so this app
# receives wholesale pricing. Must match RESELLER_STOREFRONT_KEY in apps/api/.env.
#
# Deliberately NOT prefixed NEXT_PUBLIC_ — that would compile it into the browser
# bundle, where anyone could read and replay it.
RESELLER_STOREFRONT_KEY=""
