# Base URL of the NestJS API
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Legal business details shown on /contact and the compliance pages (privacy
# policy, terms, refund policy) — required for payment gateway
# (Cashfree/Razorpay) compliance review. See
# packages/storefront/src/lib/business.ts. Leave unset in development; fill in
# with real, verified values before going live — never invent these.
NEXT_PUBLIC_BUSINESS_NAME=""
NEXT_PUBLIC_BUSINESS_ADDRESS=""
NEXT_PUBLIC_BUSINESS_EMAIL=""
# One-line, truthful statement of where products are sourced from (e.g. an
# authorised dealer name, or "authorised retail partners across India").
NEXT_PUBLIC_BUSINESS_SOURCING=""
